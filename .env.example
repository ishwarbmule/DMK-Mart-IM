# Frontend / Vercel Environment Variables
VITE_APP_NAME="DMK Mart Enterprise ERP"
VITE_APP_VERSION="4.5.0-PROD"
VITE_DEFAULT_CURRENCY="INR"
VITE_DEFAULT_TENANT_ID="00000000-0000-0000-0000-000000000001"

# Polyglot Database Credentials (Local / Cloud Postgres & ClickHouse)
POSTGRES_DB="dmk_mart_erp"
POSTGRES_USER="dmk_admin"
POSTGRES_PASSWORD="enterprise_secure_password_2026"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432

# Redis L2 Distributed Cache
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="enterprise_redis_secret_2026"

# Apache Kafka Event Mesh
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="dmk-mart-engine"

# AI Swarm & Multimodal OCR API Keys (Optional)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
NIC_GST_AUTH_TOKEN=""
